# --- build output: regenerated by 'ant jar', never committed ---
build/
dist/
*.class

# --- thrift generated code: regenerated by thriftgen.sh ---
gen-java/
gen-py/

# --- NetBeans per-developer settings: local paths, your machine only ---
nbproject/private/
.nb-gradle/

# --- logs, temp, OS noise ---
*.log
*.pid
nohup.out
.DS_Store
Thumbs.db

# --- SECRETS: never, under any circumstances ---
conf/production.ini
conf/*.local.ini
*.pem
*.key
